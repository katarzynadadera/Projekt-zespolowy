<!DOCTYPE html>
<html lang="pl">
<head>
    <title>Zapomniałeś hasła? - Księgarnia Online</title>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>
 
    <main class="form-page">
        <div class="form-container">
            <h2>Resetuj hasło</h2>
 
            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                <p class="message success"><%= successMessage %></p>
            <% } %>
 
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <p class="message error"><%= errorMessage %></p>
            <% } %>
 
            <p>Podaj swój adres email, aby otrzymać link do resetowania hasła.</p>
            <form action="/forgot-password" method="POST" novalidate>
                <div class="form-group">
                    <label for="email">Email:</label>
                    <input type="text" id="email" name="email" required>
                </div>
                <button type="submit" class="button primary">Wyślij link</button>
            </form>
            <p><a href="/login">Wróć do logowania</a></p>
        </div>
    </main>
 
    <%- include('partials/footer') %>
</body>
</html>