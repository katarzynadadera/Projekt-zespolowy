<!DOCTYPE html>
<html lang="pl">
<head>
    <title>Zmień Hasło - Księgarnia Online</title>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>
 
    <main class="form-page">
        <div class="form-container">
            <h2>Zmień Hasło</h2>
 
            <% if (typeof successMessage !== 'undefined' && successMessage) { %>
                <p class="message success"><%= successMessage %></p>
            <% } %>
 
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <p class="message error"><%= errorMessage %></p>
            <% } %>
 
            <form action="/change-password" method="POST" novalidate>
                <div class="form-group">
                    <label for="current-password">Aktualne hasło:</label>
                    <input type="password" id="current-password" name="currentPassword" required>
                </div>
                <div class="form-group">
                    <label for="new-password">Nowe hasło:</label>
                    <input type="password" id="new-password" name="newPassword" required>
                </div>
                <div class="form-group">
                    <label for="confirm-new-password">Potwierdź nowe hasło:</label>
                    <input type="password" id="confirm-new-password" name="confirmNewPassword" required>
                </div>
                <button type="submit" class="button primary">Zmień Hasło</button>
            </form>
            <p style="margin-top: 20px;"><a href="/profile">Wróć do profilu</a></p>
        </div>
    </main>
 
    <%- include('partials/footer') %>
</body>
</html>