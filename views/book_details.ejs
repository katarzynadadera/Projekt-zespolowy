<!DOCTYPE html>
<html lang="pl">
<head>
    <title><%= typeof book !== 'undefined' ? book.title : 'Szczegóły Książki' %> - Księgarnia Online</title>
    <%- include('partials/head') %>
</head>
<body>
    <%- include('partials/header') %>
 
    <main class="book-details-page">
        <div class="book-details-container">
            <% if (typeof errorMessage !== 'undefined' && errorMessage) { %>
                <p class="message error"><%= errorMessage %></p>
                <p><a href="/browse">Wróć do przeglądania książek</a></p>
            <% } else if (typeof book !== 'undefined' && book) { %>
                <div class="book-details-content">
                    <div class="book-details-cover">
                        <img src="<%= book.cover_image_url ? book.cover_image_url : '/images/covers/no_cover.jpg' %>" alt="<%= book.title %>" class="book-cover-image">
                    </div>
                    <div class="book-details-info">
                        <h2><%= book.title %></h2>
                        <p class="book-details-author">Autor: <strong><%= book.author_name %></strong></p>
                        <p class="book-details-category">Kategoria: <span><%= book.category_name %></span></p>
                        <p class="book-details-year">Rok wydania: <%= book.publication_year %></p>
                        <p class="book-details-isbn">ISBN: <%= book.isbn || 'Brak' %></p>
                       
                        <% if (book.is_digital_available) { %>
                            <div style="margin-top: 20px; padding: 15px; background: #f0f9ff; border-radius: 8px;">
                                <p class="book-details-type" style="display:flex; align-items:center; gap:8px;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="2" width="16" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>
                                    <strong>E-book dostępny</strong>
                                </p>
                                <p class="book-details-price">Cena: <strong><%= book.digital_price %> PLN</strong></p>
                               
                                <form class="add-to-cart-form" data-book-id="<%= book.id %>" data-format="digital">
                                    <button type="submit" class="button primary action-button">
                                        Do koszyka (E-book)
                                    </button>
                                </form>
                            </div>
                        <% } %>
                       
                        <% if (book.is_physical_available) { %>
                            <div style="margin-top: 20px; padding: 15px; background: #f0fdf4; border-radius: 8px;">
                                <p class="book-details-type" style="display:flex; align-items:center; gap:8px;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>
                                    <strong>Książka dostępna</strong>
                                </p>
                                <p class="book-details-price">Cena: <strong><%= book.physical_price %> PLN</strong></p>
                                <% if (book.physical_stock > 0) { %>
                                    <p class="book-details-stock">Dostępność: <strong><%= book.physical_stock %> szt.</strong></p>
                                   
                                    <form class="add-to-cart-form" data-book-id="<%= book.id %>" data-format="physical">
                                        <button type="submit" class="button primary action-button">
                                            Do koszyka (Książka)
                                        </button>
                                    </form>
                                <% } else { %>
                                    <p style="color: #991b1b; font-weight: 600;">Brak w magazynie</p>
                                <% } %>
                            </div>
                        <% } %>
 
                        <% if (!book.is_digital_available && !book.is_physical_available) { %>
                            <div style="margin-top: 20px; padding: 15px; background: #fef2f2; border-radius: 8px;">
                                <p style="color: #991b1b; font-weight: 600; display:flex; align-items:center; gap:8px;">
                                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="15" y1="9" x2="9" y2="15"></line><line x1="9" y1="9" x2="15" y2="15"></line></svg>
                                    Książka obecnie niedostępna
                                </p>
                            </div>
                        <% } %>
 
                        <div class="book-details-description">
                            <h3>Opis:</h3>
                            <p><%= book.description || 'Brak opisu.' %></p>
                        </div>
                    </div>
                </div>
                <p style="margin-top: 30px;"><a href="/browse">Wróć do przeglądania książek</a></p>
            <% } %>
        </div>
    </main>
 
    <div id="success-modal" class="modal-overlay">
        <div class="modal-content">
            <div class="modal-icon">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="#10B981" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            </div>
            <h3>Sukces!</h3>
            <p>Produkt został dodany do Twojego koszyka.</p>
            <div class="modal-actions">
                <button onclick="closeModal()" class="button secondary">Kontynuuj zakupy</button>
                <a href="/checkout/cart" class="button primary">Przejdź do płatności</a>
            </div>
        </div>
    </div>
 
    <%- include('partials/footer') %>
 
    <script src="/js/cart-actions.js"></script>
</body>
</html>